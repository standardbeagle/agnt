{
  "name": "design-steer",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "fps": 25,
  "env": {
    "PROXY_ID": "demo-steer",
    "PROXY_PORT": 18202,
    "UPSTREAM_PORT": 8021
  },
  "setup": {
    "upstream": "../../serve-live.mjs",
    "waitFor": "http://127.0.0.1:8021/",
    "proxy": {
      "id": "demo-steer",
      "target": "http://127.0.0.1:8021",
      "port": 18202
    }
  },
  "segments": [
    {
      "id": "card-intro",
      "type": "card",
      "dur": 4.2,
      "kicker": "agnt demo \u00b7 design mode",
      "title": "Steer it. Iterate. Then build.",
      "sub": "Chat prompts steer the alternatives, a second round tightens them, and the winner lands in the live DOM."
    },
    {
      "id": "steer",
      "type": "browser",
      "script": "./segments/steer.mjs",
      "keep": [
        [
          "start",
          "mark:chat-1+1.2"
        ],
        [
          "mark:round-1-1.2",
          "mark:round-1+3.4"
        ],
        [
          "mark:chat-2+0.5",
          "end"
        ]
      ]
    },
    {
      "id": "card-outro",
      "type": "card",
      "dur": 4.2,
      "kicker": "",
      "title": "Prompt-steerable, scheme-safe",
      "sub": "github.com/standardbeagle/agnt"
    }
  ]
}