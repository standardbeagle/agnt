{
  "name": "live-sketch",
  "viewport": {"width": 1440, "height": 900},
  "fps": 25,
  "env": {"PROXY_ID": "demo-sketch", "PROXY_PORT": 18191, "UPSTREAM_PORT": 8021},
  "setup": {
    "upstream": "../../serve-live.mjs",
    "waitFor": "http://127.0.0.1:8021/",
    "proxy": {"id": "demo-sketch", "target": "http://127.0.0.1:8021", "port": 18191}
  },
  "segments": [
    {
      "id": "card-intro", "type": "card", "dur": 4.0,
      "kicker": "agnt demo · sketch mode",
      "title": "Draw it, don't describe it",
      "sub": "Annotate the running app itself — the agent gets the drawing and the elements under it."
    },
    {
      "id": "sketch", "type": "browser", "script": "./segments/sketch.mjs",
      "keep": [
        ["start", "mark:drawn+1.0"],
        ["mark:sent-0.5", "end"]
      ]
    },
    {
      "id": "card-outro", "type": "card", "dur": 4.0,
      "kicker": "", "title": "Sketch on the live UI",
      "sub": "github.com/standardbeagle/agnt"
    }
  ]
}
