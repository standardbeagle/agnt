// Neither `stall` nor `max-cpu` is pinned here, and both omissions are deliberate.
//
// `stall` is a hang backstop, not a runtime budget: the scaffolded 60s fired 32 times across 959
// supervised runs and caught no actual hang, killing healthy work like a cold `go build ./...`.
// Omitting it takes tman's built-in 30m, and keeps taking whatever the corrected built-in is —
// writing 60s here is exactly what stopped these files inheriting that fix. Use `max-time` for a
// real deadline.
//
// `max-cpu` is normalised across all cores, so the scaffolded 95 meant "kill anything that
// saturates this machine" — which is what a healthy parallel build or threaded test run does.
defaults {
    max-mem 2048
    max-parallel 2
}

// The full suite is one supervised tree: the go driver, compile/link steps and the test binary
// together reach 2.1-2.3GB, which the 2048 default culled twice (review-baseline, review-suite).
// The test binaries themselves are small (internal/daemon peaks near 180MB), so this is toolchain
// headroom, not a licence for tests to grow. `test-pkg` keeps a focused run far below it.
alias "test" {
    command "go"
    args "test" "-p" "1" "./..."
    max-mem 4096
}

alias "test-pkg" {
    command "go"
    args "test" "-p" "1" "-count=1"
}

alias "bench" {
    command "go"
    args "test" "-p" "1" "-run" "^$" "-bench" "." "-benchmem" "./..."
}


// Portable replacements for the make targets of the same name: no make or POSIX shell needed,
// so they run the same on Windows, macOS and Linux. CI still calls the make targets, which
// delegate here.
alias "vendor-check" {
    command "go"
    args "run" "./scripts/check.go" "vendor"
    max-time "10m"
}

alias "cross-compile-check" {
    command "go"
    args "run" "./scripts/check.go" "cross"
    max-time "15m"
    max-mem 4096
}
