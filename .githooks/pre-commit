#!/bin/bash
# Pre-commit hook for agnt (TRACKED — this file is the source of truth).
#
# Install once per clone:
#   git config core.hooksPath .githooks
#   (or: make install-hooks)
#
# core.hooksPath makes git run hooks from this tracked directory instead of
# .git/hooks/, so the hook ships with the repo and every contributor runs the
# same checks. There is no copy step to keep in sync.
#
# Runs gofmt + go vet globally; runs `go test` only on packages containing
# staged Go files. Full-suite runs belong in CI, not on every commit.

set -e

echo "Running pre-commit checks..."

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v '^vendor/' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    echo "No Go files staged, skipping Go checks."
    echo "Pre-commit checks passed!"
    exit 0
fi

echo "Checking formatting with gofmt..."
UNFORMATTED=$(gofmt -l $STAGED_GO_FILES)
if [ -n "$UNFORMATTED" ]; then
    echo "ERROR: The following files are not formatted:"
    echo "$UNFORMATTED"
    echo ""
    echo "Run 'gofmt -w <file>' or 'make fmt' to fix."
    exit 1
fi
echo "Formatting check passed."

echo "Running go vet..."
go vet ./...
echo "Vet passed."

# Scope `go test` to packages with staged changes. One `go test`
# invocation per unique package directory.
CANDIDATE_PKGS=$(echo "$STAGED_GO_FILES" | xargs -n1 dirname | sort -u | sed 's|^|./|' | xargs)
# Drop directories that are not buildable Go packages. ./scripts holds only
# `//go:build ignore` capture scripts (run via `go run`), so `go test ./scripts`
# fails with "build constraints exclude all Go files" and can never pass. Such a
# directory is not a package to test, not a test failure.
PKGS=""
for pkg in $CANDIDATE_PKGS; do
    if go list "$pkg" >/dev/null 2>&1; then
        PKGS="$PKGS $pkg"
    else
        echo "Skipping $pkg (no buildable Go package — e.g. all files build-constrained out)."
    fi
done
PKGS=$(echo "$PKGS" | xargs || true)
if [ -n "$PKGS" ]; then
    echo "Running tests for affected packages: $PKGS"
    # -p 1 serializes per-package execution to avoid cross-package
    # scheduler starvation that surfaces as flakes under pre-commit load
    # (daemon + cmd/agnt together exhaust CPU budgets; serially each
    # package is deterministic).
    # -race detects data races (2-5x overhead, essential for correctness).
    RUN_START=$SECONDS
    go test -count=1 -race -timeout 300s -p 1 $PKGS
    RUN_ELAPSED=$((SECONDS - RUN_START))

    # For fast packages (<10s), repeat 2 more times to surface transient
    # flakes (PID-reuse races, timing windows, scheduler jitter).
    # Slow packages — e.g. internal/daemon at ~90s — skip the repeats;
    # the single race pass is already a meaningful check, and 3× would
    # be ~270s. See daemon-architecture.md § Test startup contract for
    # why daemon tests are inherently slow.
    if [ "$RUN_ELAPSED" -lt 10 ]; then
        echo "Fast package (${RUN_ELAPSED}s) — running 2 more passes for flake detection..."
        go test -count=2 -race -timeout 300s -p 1 $PKGS
    else
        echo "Slow package (${RUN_ELAPSED}s) — single race pass sufficient."
    fi
    echo "Affected-package tests passed."
else
    echo "No packages to test."
fi

echo "Pre-commit checks passed!"
